  "description": "Vendor-neutral crew of coding agents (Claude Code, Codex, ...) working as one team through GitHub Issues and PRs",
  "type": "module",
  "bin": {
    "crew": "bin/crew.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
